# Synk backend environment configuration.
# Copy this file to .env and adjust values as needed.
APP_NAME=synk-backend
ENVIRONMENT=development
DEBUG=false

# Database
# For local development with Docker Compose (main DB on port 5432, test DB on port 5433)
DATABASE_URL=postgresql+asyncpg://synk:synk@localhost:5432/synk
TEST_DATABASE_URL=postgresql+asyncpg://synk:synk@localhost:5433/synk_test

# For local PostgreSQL installation (single database)
# DATABASE_URL=postgresql+asyncpg://synk:synk@localhost:5432/synk
# TEST_DATABASE_URL=postgresql+asyncpg://synk:synk@localhost:5432/synk
